# Copy to .env and edit. Every value is optional; an EMPTY value means "use
# the built-in default".

# The address game clients reach this host on (LAN or VPN IP). It is handed
# to the client inside the protocol (the battle and group endpoints), so
# 127.0.0.1 (the default) only works for a client on this same machine. Use
# the same value OpenLobby's .env has.
POL_ADVERTISE=

# Any FMO_* knob fmo.py reads can be set here to override its release
# default (services/fmo.py, RELEASE_DEFAULTS, lists the values a fresh
# server runs with; `grep -o 'FMO_[A-Z_0-9]*' services/fmo.py | sort -u`
# lists every knob). Add the variable to docker-compose.yml's fmo
# environment as well: compose enumerates what reaches the container.

# The lobby NPC editor (--profile editor): the token its page requires when
# bound to a LAN address. Empty keeps the editor on loopback only.
FMO_DEVTOOL_TOKEN=

# The City Control board (--profile board): the public URL the Discord
# messages link to and the webhook the standings post to. Empty = no Discord.
POL_BOARDS_FMO_URL=
POL_BOARDS_FMO_DISCORD_WEBHOOK=
