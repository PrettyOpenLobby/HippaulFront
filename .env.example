# Copy to .env and edit. Every value is optional; an EMPTY value means "use
# the built-in default".

# The address game clients reach this host on (LAN or VPN IP). It is handed
# to the client inside the protocol (the battle and group endpoints), so
# 127.0.0.1 (the default) only works for a client on this same machine. Use
# the same value OpenLobby's .env has.
POL_ADVERTISE=

# Any FMO_* knob fmo.py reads can be set here to override its release
# default (services/fmo.py, RELEASE_DEFAULTS, lists the values a fresh
# server runs with; `grep -o 'FMO_[A-Z_0-9]*' services/fmo.py | sort -u`
# lists every knob). Add the variable to docker-compose.yml's fmo
# environment as well: compose enumerates what reaches the container.
#
# Battle and economy knobs that are ON by default (the release values below;
# set 0 to turn one off):
# FMO_KILL_CONTRIB=50        contribution per enemy destroyed
# FMO_KILL_BONUS_HS=500      H$ per kill, a "Kill bonus" line at the Personnel Officer
# FMO_WIN_MONEY=1500         H$ added to a won battle
# FMO_WIN_CONTRIB=30         contribution added to a won battle
# FMO_BATTLE_DUMMY_AI=101    the client runs the enemy with brain 101 (0 = a dummy that stands still)
# FMO_BATTLE_ENEMIES=3:120:40  enemy squad: count, distance from the drop point, gap between enemies
# FMO_TRADE=1                the player trade service
# FMO_CEASEFIRE=1            the phase-end ceasefire bonus for First Sergeant and above
# FMO_REVIEW=promote         the officer review above Captain keeps or promotes (full = can also demote)

# The lobby NPC editor (--profile editor): the token its page requires when
# bound to a LAN address. Empty keeps the editor on loopback only.
FMO_DEVTOOL_TOKEN=

# The City Control board (--profile board): the public URL the Discord
# messages link to and the webhook the standings post to. Empty = no Discord.
POL_BOARDS_FMO_URL=
POL_BOARDS_FMO_DISCORD_WEBHOOK=
# Optional: post as a Discord bot instead (or as well). With a token the bot
# needs no webhook: run /fmoboard in the channel it should post in. The app id
# registers the command and the public key verifies Discord's interaction calls.
POL_BOARDS_FMO_DISCORD_BOT_TOKEN=
POL_BOARDS_FMO_DISCORD_APP_ID=
POL_BOARDS_FMO_DISCORD_PUBLIC_KEY=
